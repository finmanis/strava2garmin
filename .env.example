# Strava API app credentials — create your app at strava.com/settings/api
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# Initial Strava refresh token — obtained via one-time OAuth flow
# After the first run this is persisted to strava_refresh_token.txt (and the Gist in CI)
# so this env var is only used as a bootstrap fallback
STRAVA_REFRESH_TOKEN=your_strava_refresh_token

# Garmin Connect credentials
GARMIN_EMAIL=your_garmin_email@example.com
GARMIN_PASSWORD=your_garmin_password_here

# GitHub Gist state persistence (CI only)
# GIST_ID: the ID of a secret gist that stores last_synced_id.txt and strava_refresh_token.txt
# GH_PAT: a Personal Access Token with the "gist" scope
GIST_ID=your_gist_id_here
GH_PAT=your_github_personal_access_token_here
